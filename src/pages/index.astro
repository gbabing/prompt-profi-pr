---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allPrompts = await getCollection('prompts');
const prompts = allPrompts
  .filter((p) => !p.data.pending)
  .map((p) => p.data);

// Kategorie-Definitionen mit Beschreibung und Reihenfolge
const categoryMeta = [
  {
    name: 'Krisenkommunikation',
    description: 'Holding Statements, Q&A-Kataloge, Shitstorm-Response und Stakeholder-Abfolgen für den Ernstfall.',
  },
  {
    name: 'Pressemitteilungen',
    description: 'Launches, Personalien, Geschäftszahlen, Studien — strukturiert im klassischen PR-Format.',
  },
  {
    name: 'Strategische Konzeption',
    description: 'Kommunikationsstrategien, Messaging Architecture, Briefings und Erfolgsmessung.',
  },
  {
    name: 'Social Media',
    description: 'Content-Pläne, LinkedIn-Posts, Karussells und Community-Management mit Substanz.',
  },
  {
    name: 'Stakeholder-Mapping',
    description: 'Stakeholder-Maps, Power-Interest-Matrix, Briefe und Dialogstrategien.',
  },
  {
    name: 'Recherche & Analyse',
    description: 'Medienanalysen, Wettbewerbsvergleiche, Trend- und Zielgruppenanalysen.',
  },
  {
    name: 'Sprachliche Qualitätskontrolle',
    description: 'Textchecks, Tonalitätsangleich, Lektorat und Verständlichkeitsprüfung.',
  },
];

// Anzahl Prompts pro Kategorie zählen
const counts = {};
for (const p of prompts) {
  counts[p.category] = (counts[p.category] || 0) + 1;
}

const categories = categoryMeta.map((c) => ({
  ...c,
  count: counts[c.name] || 0,
}));

const total = prompts.length;
---

<Layout title="Prompt-Profi · KI-Prompts für Kommunikationsprofis">
  <header class="hero">
    <h1>Prompt-Profi</h1>
    <p>Geprüfte KI-Prompts für PR und Kommunikation. Wähle eine Kategorie, um loszulegen.</p>
  </header>

  <ul class="cat-grid">
    {categories.map((c) => (
      <li>
        <a href={`tool?kategorie=${encodeURIComponent(c.name)}`} class="cat-card">
          <div class="cat-card-top">
            <h2>{c.name}</h2>
            <span class="cat-count">{c.count}</span>
          </div>
          <p class="cat-desc">{c.description}</p>
          <span class="cat-arrow">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </a>
      </li>
    ))}
  </ul>

  <div class="all-link-wrap">
    <a href="tool" class="all-link">Alle {total} Prompts ansehen</a>
  </div>
</Layout>

<style>
  .cat-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1rem;
  }

  .cat-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.3s var(--ease-out);
    box-shadow: var(--shadow-xs);
    position: relative;
    overflow: hidden;
  }

  .cat-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, rgba(0, 113, 227, 0.06), transparent 55%);
    opacity: 0;
    transition: opacity 0.3s var(--ease-out);
    pointer-events: none;
  }

  .cat-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
  }

  .cat-card:hover::before { opacity: 1; }

  .cat-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.6rem;
    position: relative;
  }

  .cat-card h2 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .cat-count {
    flex-shrink: 0;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    line-height: 1.6;
  }

  .cat-desc {
    margin: 0 0 1.5rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.55;
    position: relative;
    flex-grow: 1;
  }

  .cat-arrow {
    display: inline-flex;
    align-items: center;
    color: var(--accent);
    position: relative;
    transition: transform 0.2s var(--ease-smooth);
  }

  .cat-arrow svg { width: 20px; height: 20px; }

  .cat-card:hover .cat-arrow { transform: translateX(4px); }

  .all-link-wrap {
    margin-top: 2.5rem;
    text-align: center;
  }

  .all-link {
    display: inline-block;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    padding: 0.6rem 1.25rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    transition: all 0.2s var(--ease-smooth);
  }

  .all-link:hover {
    color: var(--text);
    background: var(--surface-hover);
  }
</style>